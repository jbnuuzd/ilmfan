{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilmiy-yuksalish",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ilmiy-yuksalish" }
  ],
  // Dashboard'da kiritilgan o'zgaruvchilar har deploy'da o'chib ketmasligi uchun
  "keep_vars": true,
  "observability": { "enabled": true }
}
